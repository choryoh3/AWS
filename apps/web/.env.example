# ==========================================================
# 環境変数の雛形。コピーして .env.local を作り、値を入れる。
#   cp .env.example .env.local
# .env.local は Git にコミットしない（.gitignore で除外済み）。
# ==========================================================

# --- データベース（PostgreSQL）---
DATABASE_URL=postgres://app:app@localhost:5432/app

# --- 認証（Better Auth）---
# 32 文字以上の乱数。作り方: openssl rand -base64 32
BETTER_AUTH_SECRET=
# アプリの URL（開発中は http://localhost:3000）
BETTER_AUTH_URL=http://localhost:3000
# 任意。ブラウザから見たアプリの URL（省略可）
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true: 未登録のメールでも初回ログイン時にアカウントを作る / false: 登録済みのみ
AUTH_ALLOW_SIGNUP=true

# --- メール送信（SMTP）---
# 開発: Mailpit（localhost:1025、認証なし）
# 本番: Amazon SES の SMTP（例: email-smtp.ap-northeast-1.amazonaws.com、587 番、STARTTLS）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Login <no-reply@example.com>"
